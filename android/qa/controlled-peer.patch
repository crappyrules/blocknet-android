@@ -0,0 +1,59 @@
+package main
+
+import "testing"
+
+const qaTestPeerID = "12D3KooWHgLj9iCfn6kt8ti7WZg1pCG1yD3n2UGh5jctH8r4uvUA"
+
+func TestQAPeerOnlyRequiresPrivateMobileTestnetPeer(t *testing.T) {
+	valid := Settings{ExtraPeers: []string{"/ip4/192.168.50.10/tcp/38091/p2p/" + qaTestPeerID}}
+	t.Setenv("BLOCKNET_QA_TESTNET_PEER_ONLY", "1")
+	id, enabled, err := qaPeerOnly(valid, true, true)
+	if err != nil || !enabled || id.String() != qaTestPeerID {
+		t.Fatalf("valid fixture rejected: enabled=%t err=%v", enabled, err)
+	}
+	for _, tc := range []struct {
+		name            string
+		st              Settings
+		testnet, mobile bool
+	}{
+		{"mainnet", valid, false, true},
+		{"desktop", valid, true, false},
+		{"missing", Settings{}, true, true},
+		{"extra", Settings{ExtraPeers: append(valid.ExtraPeers, valid.ExtraPeers[0])}, true, true},
+		{"public", Settings{ExtraPeers: []string{"/ip4/198.51.100.42/tcp/38080/p2p/" + qaTestPeerID}}, true, true},
+		{"loopback", Settings{ExtraPeers: []string{"/ip4/127.0.0.1/tcp/38091/p2p/" + qaTestPeerID}}, true, true},
+		{"dns", Settings{ExtraPeers: []string{"/dns4/example.invalid/tcp/38091/p2p/" + qaTestPeerID}}, true, true},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			if _, _, err := qaPeerOnly(tc.st, tc.testnet, tc.mobile); err == nil {
+				t.Fatal("uncontrolled fixture was accepted")
+			}
+		})
+	}
+	t.Setenv("BLOCKNET_QA_TESTNET_PEER_ONLY", "bad")
+	if _, _, err := qaPeerOnly(valid, true, true); err == nil {
+		t.Fatal("unknown QA mode was accepted")
+	}
+	t.Setenv("BLOCKNET_QA_TESTNET_PEER_ONLY", "")
+	if _, enabled, err := qaPeerOnly(valid, false, false); err != nil || enabled {
+		t.Fatalf("ordinary mode changed: enabled=%t err=%v", enabled, err)
+	}
+}
+
+func TestQAStartupSkipsEveryPublicSeedResolver(t *testing.T) {
+	called := false
+	got := qaStartupSeeds(true, []string{"public-fallback"}, func() []string {
+		called = true
+		return []string{"public-dns"}
+	})
+	if called || len(got) != 0 {
+		t.Fatal("controlled mode consulted public seeds")
+	}
+	got = qaStartupSeeds(false, []string{"public-fallback"}, func() []string {
+		called = true
+		return nil
+	})
+	if !called || len(got) != 1 || got[0] != "public-fallback" {
+		t.Fatal("ordinary seed fallback changed")
+	}
+}
