@@ -0,0 +1,36 @@
+package p2p
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/libp2p/go-libp2p/core/peer"
+)
+
+func TestQAOnlyMobileConnectsFixtureAndRejectsOtherDial(t *testing.T) {
+	fixture := mustNewTestNode(t)
+	defer func() { _ = fixture.Stop() }()
+	other := mustNewTestNode(t)
+	defer func() { _ = other.Stop() }()
+	cfg := DefaultNodeConfig()
+	cfg.MobileClient = true
+	cfg.AllowOfflineStart = true
+	cfg.SeedNodes = nil
+	cfg.QAOnlyPeerID = fixture.PeerID()
+	mobile, err := NewNode(cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = mobile.Stop() }()
+	mustConnectNodes(t, mobile, fixture)
+	ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+	defer cancel()
+	err = mobile.host.Connect(ctx, peer.AddrInfo{ID: other.PeerID(), Addrs: other.Addrs()})
+	if err == nil || len(mobile.host.Network().ConnsToPeer(other.PeerID())) != 0 {
+		t.Fatal("mobile connected to an unapproved peer")
+	}
+	if len(mobile.host.Network().ConnsToPeer(fixture.PeerID())) != 1 {
+		t.Fatal("mobile lost its approved fixture connection")
+	}
+}
diff --git a/qa_peer_only.go b/qa_peer_only.go
new file mode 100644
index 0000000..b472aa6
--- /dev/null
+++ b/qa_peer_only.go
@@ -0,0 +1,57 @@
+package main
+
+import (
+	"fmt"
+	"net"
+	"os"
+	"strconv"
+
+	"github.com/libp2p/go-libp2p/core/peer"
+	"github.com/multiformats/go-multiaddr"
+)
+
+// qaPeerOnly is compiled only into the disposable bootstrap QA Core build.
+// It fails closed to one private IPv4 TCP peer and never writes a settings key.
+func qaPeerOnly(st Settings, testnet, mobile bool) (peer.ID, bool, error) {
+	mode := os.Getenv("BLOCKNET_QA_TESTNET_PEER_ONLY")
+	if mode == "" {
+		return "", false, nil
+	}
+	if mode != "1" || !testnet || !mobile || len(st.ExtraPeers) != 1 {
+		return "", false, fmt.Errorf("QA peer-only mode requires mobile testnet and exactly one extra peer")
+	}
+	addr, err := multiaddr.NewMultiaddr(st.ExtraPeers[0])
+	if err != nil {
+		return "", false, fmt.Errorf("invalid QA peer address: %w", err)
+	}
+	parts := addr.Protocols()
+	if len(parts) != 3 || parts[0].Code != multiaddr.P_IP4 ||
+		parts[1].Code != multiaddr.P_TCP || parts[2].Code != multiaddr.P_P2P {
+		return "", false, fmt.Errorf("QA peer must use private IPv4 TCP with a peer ID")
+	}
+	ipString, _ := addr.ValueForProtocol(multiaddr.P_IP4)
+	ip := net.ParseIP(ipString)
+	portString, _ := addr.ValueForProtocol(multiaddr.P_TCP)
+	port, portErr := strconv.Atoi(portString)
+	if ip == nil || !ip.IsPrivate() || portErr != nil || port < 1 || port > 65535 {
+		return "", false, fmt.Errorf("QA peer must have a private IPv4 address and valid TCP port")
+	}
+	info, err := peer.AddrInfoFromP2pAddr(addr)
+	if err != nil || info == nil || info.ID == "" {
+		return "", false, fmt.Errorf("QA peer ID is invalid")
+	}
+	return info.ID, true, nil
+}
+
+// qaStartupSeeds must not call resolver in peer-only mode: even DNS lookup of
+// public seed hosts is outside this controlled fixture's network boundary.
+func qaStartupSeeds(qaOnly bool, fallback []string, resolver func() []string) []string {
+	if qaOnly {
+		return nil
+	}
+	seeds := resolver()
+	if len(seeds) == 0 {
+		return fallback
+	}
+	return seeds
+}
