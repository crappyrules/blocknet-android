@@ -0,0 +1,38 @@
+package main
+
+import (
+	"crypto/sha256"
+	"fmt"
+	"net/http"
+)
+
+// handleWalletBootstrap returns only the authenticated progress needed by the
+// Android foreground service. It works while API-locked and never returns
+// wallet records, balances, addresses, or keys.
+func (s *APIServer) handleWalletBootstrap(w http.ResponseWriter, r *http.Request) {
+	syncing := s.daemon.syncMgr != nil && s.daemon.syncMgr.IsSyncing()
+	s.mu.RLock()
+	loaded := s.wallet
+	s.mu.RUnlock()
+	if loaded == nil {
+		writeJSON(w, http.StatusOK, map[string]any{
+			"version": 1, "wallet_loaded": false,
+			"peer_tip_confirmed": s.daemon.PeerTipConfirmed(),
+			"syncing":            syncing,
+		})
+		return
+	}
+	chainHeight, chainHash, scanReady := walletScanTip(s.daemon.Chain(), loaded)
+	identity := sha256.Sum256([]byte("blocknet-wallet-activity-v1\x00" + loaded.Address()))
+	writeJSON(w, http.StatusOK, map[string]any{
+		"version":            1,
+		"wallet_loaded":      true,
+		"wallet_id":          fmt.Sprintf("%x", identity),
+		"chain_height":       chainHeight,
+		"chain_hash":         fmt.Sprintf("%x", chainHash),
+		"synced_height":      loaded.SyncedHeight(),
+		"wallet_scan_ready":  scanReady,
+		"peer_tip_confirmed": s.daemon.PeerTipConfirmed(),
+		"syncing":            syncing,
+	})
+}
