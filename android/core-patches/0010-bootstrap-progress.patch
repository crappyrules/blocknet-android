@@ -0,0 +1,94 @@
+package p2p
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"blocknet/protocol/params"
+	"github.com/libp2p/go-libp2p/core/peer"
+)
+
+// Exercise the actual Status exchange on an outbound-established mobile
+// connection. A local non-syncing flag alone must never confirm the tip.
+func TestPeerTipConfirmationUsesRealStatusExchange(t *testing.T) {
+	mobileConfig := DefaultNodeConfig()
+	mobileConfig.MobileClient = true
+	mobileConfig.AllowOfflineStart = true
+	mobileConfig.SeedNodes = nil
+	mobile, err := NewNode(mobileConfig)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = mobile.Stop() }()
+	desktop := mustNewTestNode(t)
+	defer func() { _ = desktop.Stop() }()
+	mustConnectNodes(t, mobile, desktop)
+
+	local := ChainStatus{Height: 12, TotalWork: 20,
+		NetworkID: params.NetworkID, ChainID: params.ChainID}
+	remote := local
+	server := NewSyncManager(desktop, SyncConfig{GetStatus: func() ChainStatus { return remote }})
+	server.ctx = context.Background()
+	desktop.host.SetStreamHandler(protocolID(params.ProtocolSync), server.HandleStream)
+	client := NewSyncManager(mobile, SyncConfig{GetStatus: func() ChainStatus { return local }})
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	client.ctx = ctx
+	if client.PeerTipConfirmed(90 * time.Second) {
+		t.Fatal("non-syncing without a status exchange confirmed tip")
+	}
+	client.checkSync()
+	if !client.PeerTipConfirmed(90 * time.Second) {
+		t.Fatal("equal-work Status reply from connected peer did not confirm tip")
+	}
+	client.requestSyncCheck()
+	if client.PeerTipConfirmed(90 * time.Second) {
+		t.Fatal("queued recheck retained stale peer evidence during debounce")
+	}
+	client.checkSync()
+	if !client.PeerTipConfirmed(90 * time.Second) {
+		t.Fatal("fresh equal-work exchange did not restore confirmation")
+	}
+	local.TotalWork = 19
+	if client.PeerTipConfirmed(90 * time.Second) {
+		t.Fatal("local work fell behind checked peer")
+	}
+	local.TotalWork = 20
+	remote.NetworkID = "wrong-network"
+	client.checkSync()
+	if client.PeerTipConfirmed(90 * time.Second) {
+		t.Fatal("rejected network Status preserved old tip confirmation")
+	}
+}
+
+func TestPeerTipEvidenceRequiresFreshConnectedWorkComparison(t *testing.T) {
+	now := time.Now()
+	peerA, peerB := peer.ID("a"), peer.ID("b")
+	check := func(at time.Time, checked, connected []peer.ID, peerWork, localWork uint64,
+		syncing bool) bool {
+		return peerTipEvidenceValid(at, checked, connected, peerWork, localWork,
+			syncing, 90*time.Second, now)
+	}
+	if !check(now, []peer.ID{peerA}, []peer.ID{peerA}, 10, 10, false) {
+		t.Fatal("fresh equal-work comparison must confirm tip")
+	}
+	for _, tc := range []struct {
+		name                string
+		at                  time.Time
+		checked, connected  []peer.ID
+		peerWork, localWork uint64
+		syncing             bool
+	}{
+		{"never checked", time.Time{}, nil, []peer.ID{peerA}, 0, 10, false},
+		{"stale", now.Add(-91 * time.Second), []peer.ID{peerA}, []peer.ID{peerA}, 10, 10, false},
+		{"disconnected", now, []peer.ID{peerA}, []peer.ID{peerB}, 10, 10, false},
+		{"no peers", now, []peer.ID{peerA}, nil, 10, 10, false},
+		{"behind in work", now, []peer.ID{peerA}, []peer.ID{peerA}, 11, 10, false},
+		{"sync active", now, []peer.ID{peerA}, []peer.ID{peerA}, 10, 10, true},
+	} {
+		if check(tc.at, tc.checked, tc.connected, tc.peerWork, tc.localWork, tc.syncing) {
+			t.Fatalf("%s incorrectly confirmed tip", tc.name)
+		}
+	}
+}
