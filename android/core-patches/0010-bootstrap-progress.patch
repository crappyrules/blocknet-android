@@ -0,0 +1,76 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"testing"
+
+	"blocknet/wallet"
+)
+
+func TestWalletBootstrapLockedProgressIsNarrowAndExact(t *testing.T) {
+	chain, _, cleanup := mustCreateTestChain(t)
+	defer cleanup()
+	daemon, stop := mustStartTestDaemon(t, chain)
+	defer stop()
+	loaded, err := wallet.NewWallet(filepath.Join(t.TempDir(), "bootstrap.wallet.dat"),
+		[]byte("synthetic-password"), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	api := NewAPIServer(daemon, loaded, nil, t.TempDir(), nil)
+	private := http.NewServeMux()
+	api.registerPrivateRoutes(private)
+	authorized := authMiddleware("synthetic-token", private)
+	request := func(handler http.Handler, token string) *httptest.ResponseRecorder {
+		req := httptest.NewRequest("GET", "/api/wallet/bootstrap", nil)
+		if token != "" {
+			req.Header.Set("Authorization", "Bearer "+token)
+		}
+		res := httptest.NewRecorder()
+		handler.ServeHTTP(res, req)
+		return res
+	}
+	if got := request(authorized, "").Code; got != 401 {
+		t.Fatalf("without auth=%d", got)
+	}
+	public := http.NewServeMux()
+	api.registerPublicRoutes(public)
+	if got := request(public, "").Code; got != 404 {
+		t.Fatalf("public route=%d", got)
+	}
+	api.locked = true
+	res := request(authorized, "synthetic-token")
+	if res.Code != 200 {
+		t.Fatalf("locked progress=%d", res.Code)
+	}
+	var progress map[string]any
+	if err := json.Unmarshal(res.Body.Bytes(), &progress); err != nil {
+		t.Fatal(err)
+	}
+	for key := range progress {
+		switch key {
+		case "version", "wallet_loaded", "wallet_id", "chain_height", "chain_hash", "synced_height",
+			"wallet_scan_ready", "peer_tip_confirmed", "syncing":
+		default:
+			t.Fatalf("unexpected private field %s", key)
+		}
+	}
+	if progress["wallet_loaded"] != true || progress["peer_tip_confirmed"] != false {
+		t.Fatalf("unexpected bootstrap result: %v", progress)
+	}
+	api.wallet = nil
+	res = request(authorized, "synthetic-token")
+	if res.Code != 200 {
+		t.Fatalf("unloaded progress=%d", res.Code)
+	}
+	progress = nil
+	if err := json.Unmarshal(res.Body.Bytes(), &progress); err != nil {
+		t.Fatal(err)
+	}
+	if progress["wallet_loaded"] != false || progress["wallet_id"] != nil {
+		t.Fatal("unloaded response exposed wallet identity")
+	}
+}
diff --git a/bootstrap_shutdown_proof.go b/bootstrap_shutdown_proof.go
new file mode 100644
index 0000000..61cd43c
--- /dev/null
+++ b/bootstrap_shutdown_proof.go
@@ -0,0 +1,78 @@
+package main
+
+import (
+	"crypto/sha256"
+	"encoding/json"
+	"fmt"
+	"os"
+	"path/filepath"
+	"regexp"
+
+	"blocknet/wallet"
+)
+
+// The proof is only a local, nonce-bound shutdown receipt. It contains no
+// wallet records or secrets and is never served by the API.
+type bootstrapShutdownProof struct {
+	Version     int    `json:"version"`
+	Nonce       string `json:"nonce"`
+	WalletID    string `json:"wallet_id"`
+	ChainHeight uint64 `json:"chain_height"`
+	ChainHash   string `json:"chain_hash"`
+}
+
+var proofNoncePattern = regexp.MustCompile(`^[0-9a-f]{32}$`)
+
+func shutdownProofForTip(nonce string, w *wallet.Wallet, chain *Chain) (bootstrapShutdownProof, error) {
+	if !proofNoncePattern.MatchString(nonce) || w == nil || chain == nil {
+		return bootstrapShutdownProof{}, fmt.Errorf("invalid bootstrap shutdown proof request")
+	}
+	height, hash, ready := walletScanTip(chain, w)
+	if !ready {
+		return bootstrapShutdownProof{}, fmt.Errorf("wallet is not at the final canonical tip")
+	}
+	id := sha256.Sum256([]byte("blocknet-wallet-activity-v1\x00" + w.Address()))
+	return bootstrapShutdownProof{1, nonce, fmt.Sprintf("%x", id), height, fmt.Sprintf("%x", hash)}, nil
+}
+
+func writeBootstrapShutdownProof(path, nonce string, w *wallet.Wallet, chain *Chain, peerConfirmed bool) error {
+	if path == "" && nonce == "" {
+		return nil // Desktop and older Android callers do not request a proof.
+	}
+	if path == "" || filepath.Base(path) != "bootstrap-shutdown-proof.json" {
+		return fmt.Errorf("invalid bootstrap proof path")
+	}
+	if !peerConfirmed {
+		return fmt.Errorf("peer tip was not confirmed before shutdown")
+	}
+	proof, err := shutdownProofForTip(nonce, w, chain)
+	if err != nil {
+		return err
+	}
+	parent := filepath.Dir(path)
+	tmp, err := os.CreateTemp(parent, ".bootstrap-proof-*")
+	if err != nil {
+		return err
+	}
+	defer os.Remove(tmp.Name())
+	if err = tmp.Chmod(0600); err == nil {
+		err = json.NewEncoder(tmp).Encode(proof)
+	}
+	if err == nil {
+		err = tmp.Sync()
+	}
+	if closeErr := tmp.Close(); err == nil {
+		err = closeErr
+	}
+	if err != nil {
+		return err
+	}
+	if err = os.Rename(tmp.Name(), path); err != nil {
+		return err
+	}
+	if dir, openErr := os.Open(parent); openErr == nil {
+		_ = dir.Sync()
+		_ = dir.Close()
+	}
+	return nil
+}
