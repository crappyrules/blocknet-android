+func TestMobileWalletBirthAndRescanFloor(t *testing.T) {
+	path := filepath.Join(t.TempDir(), "disposable.wallet")
+	w, err := wallet.NewWallet(path, []byte("disposable-password"), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := walletRescanStart(w, 500); got != 0 {
+		t.Fatalf("unknown birth skipped history at %d", got)
+	}
+	mnemonic, err := w.Mnemonic()
+	if err != nil {
+		t.Fatal(err)
+	}
+	recovered, err := wallet.NewWalletFromMnemonic(filepath.Join(t.TempDir(), "recovered.wallet"),
+		[]byte("disposable-password"), mnemonic, defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, known := recovered.BirthHeight(); known {
+		t.Fatal("recovered wallet inherited a birth height")
+	}
+	fromKeys, err := wallet.NewWalletFromStealthKeys(filepath.Join(t.TempDir(), "imported.wallet"),
+		[]byte("disposable-password"), w.Keys(), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, known := fromKeys.BirthHeight(); known {
+		t.Fatal("imported-key wallet inherited a birth height")
+	}
+	w.SetBirthHeight(250)
+	if err := w.Save(); err != nil {
+		t.Fatal(err)
+	}
+	loaded, err := wallet.LoadWallet(path, []byte("disposable-password"), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := walletRescanStart(loaded, 500); got != 250-MaxReorgDepth {
+		t.Fatalf("unexpected rescan start %d", got)
+	}
+	if got := walletRescanStart(loaded, 200); got != 0 {
+		t.Fatalf("future birth skipped history at %d", got)
+	}
+	if got := walletRescanStart(loaded, 250); got != 250-MaxReorgDepth {
+		t.Fatalf("birth floor mismatch %d", got)
+	}
+	loaded.ResetScanFromHeight(150)
+	if birth, ok := loaded.BirthHeight(); !ok || birth != 250 {
+		t.Fatal("rescan changed the wallet birth height")
+	}
+}
+
+func TestMobileExplicitRescanDoesNotDismissMatchingTip(t *testing.T) {
+	chain, _, cleanup := mustCreateTestChain(t)
+	defer cleanup()
+	mustAddGenesisBlock(t, chain)
+	d, stop := mustStartTestDaemon(t, chain)
+	defer stop()
+	path := filepath.Join(t.TempDir(), "disposable.wallet")
+	w, err := wallet.NewWallet(path, []byte("disposable-password"), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	genesis := chain.GetBlockByHeight(0)
+	w.AddOutput(&wallet.OwnedOutput{TxID: [32]byte{7}, OutputIndex: 0, Amount: 5, BlockHeight: 0})
+	w.SetSyncedTip(0, genesis.Hash())
+	if err := w.Save(); err != nil {
+		t.Fatal(err)
+	}
+	scanner := wallet.NewScanner(w, defaultScannerConfig())
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	c := &CLI{ctx: ctx, cancel: cancel, daemon: d, wallet: w, scanner: scanner}
+	s := NewAPIServer(d, w, scanner, t.TempDir(), []byte("disposable-password"))
+	s.cli = c
+	c.catchUpMu.Lock()
+	busy := httptest.NewRecorder()
+	s.handleWalletRescan(busy, httptest.NewRequest(http.MethodPost, "/api/wallet/rescan", nil))
+	c.catchUpMu.Unlock()
+	if busy.Code != http.StatusConflict {
+		t.Fatalf("active scan admitted another rescan: %d", busy.Code)
+	}
+	rr := httptest.NewRecorder()
+	s.handleWalletRescan(rr, httptest.NewRequest(http.MethodPost, "/api/wallet/rescan", nil))
+	if rr.Code != http.StatusAccepted {
+		t.Fatalf("rescan status %d: %s", rr.Code, rr.Body.String())
+	}
+	var started struct {
+		Status string `json:"status"`
+		From   uint64 `json:"from_height"`
+	}
+	if err := json.Unmarshal(rr.Body.Bytes(), &started); err != nil {
+		t.Fatal(err)
+	}
+	if started.Status != "rescanning" || started.From != 0 {
+		t.Fatal("rescan did not start at genesis")
+	}
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		c.catchUpMu.Lock()
+		c.catchUpMu.Unlock()
+		status := httptest.NewRecorder()
+		s.handleWalletRescanStatus(status, httptest.NewRequest(http.MethodGet, "/api/wallet/rescan", nil))
+		if status.Code != http.StatusOK {
+			t.Fatalf("status %d", status.Code)
+		}
+		var state struct {
+			Status string `json:"status"`
+		}
+		if err := json.Unmarshal(status.Body.Bytes(), &state); err != nil {
+			t.Fatal(err)
+		}
+		if state.Status == "local_scan_complete" {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatalf("rescan did not finish: %s", state.Status)
+		}
+		time.Sleep(time.Millisecond)
+	}
+	if outputs := w.AllOutputs(); len(outputs) != 0 {
+		t.Fatal("stale genesis output survived rescan")
+	}
+	loaded, err := wallet.LoadWallet(path, []byte("disposable-password"), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if outputs := loaded.AllOutputs(); len(outputs) != 0 {
+		t.Fatal("rescan did not persist cleared outputs")
+	}
+}
