+// handleWalletRescan restarts discovery from a conservative wallet-specific
+// floor. Imported and older wallets have no trusted birth height and start at
+// genesis. The rewind is encrypted and durable before success is returned.
+func (s *APIServer) handleWalletRescan(w http.ResponseWriter, r *http.Request) {
+	if !s.requireWallet(w, r) {
+		return
+	}
+	if s.cli == nil || s.cli.ctx == nil || s.cli.ctx.Err() != nil {
+		writeError(w, http.StatusServiceUnavailable, "wallet scanner is not running")
+		return
+	}
+	if !s.cli.catchUpMu.TryLock() {
+		writeError(w, http.StatusConflict, "wallet scan is already running")
+		return
+	}
+	s.cli.scanMu.Lock()
+	s.walletOpMu.Lock()
+	defer s.walletOpMu.Unlock()
+	s.mu.RLock()
+	selected := s.wallet
+	scanner := s.scanner
+	s.mu.RUnlock()
+	s.cli.mu.RLock()
+	cliWallet := s.cli.wallet
+	s.cli.mu.RUnlock()
+	if selected == nil || scanner == nil || selected != cliWallet || s.cli.ctx.Err() != nil {
+		s.cli.scanMu.Unlock()
+		s.cli.catchUpMu.Unlock()
+		writeError(w, http.StatusConflict, "wallet changed while starting rescan")
+		return
+	}
+	chain := s.daemon.Chain()
+	chainHeight := chain.Height()
+	start := walletRescanStart(selected, chainHeight)
+	var base *Block
+	if start > 0 {
+		base = chain.GetBlockByHeight(start - 1)
+		if base == nil {
+			s.cli.scanMu.Unlock()
+			s.cli.catchUpMu.Unlock()
+			writeError(w, http.StatusServiceUnavailable, "rescan start block is unavailable")
+			return
+		}
+	}
+	checkpoint := selected.CaptureScanCheckpoint()
+	selected.ResetScanFromHeight(start)
+	if base != nil {
+		selected.SetSyncedTip(start-1, base.Hash())
+	}
+	if err := selected.Save(); err != nil {
+		selected.RestoreScanCheckpoint(checkpoint)
+		s.cli.scanMu.Unlock()
+		s.cli.catchUpMu.Unlock()
+		writeInternal(w, r, http.StatusInternalServerError, "could not persist rescan start", err)
+		return
+	}
+	s.rescanMu.Lock()
+	s.rescanWallet, s.rescanStart, s.rescanActive, s.rescanError = selected, start, true, ""
+	s.rescanMu.Unlock()
+	s.cli.scanMu.Unlock()
+	go func() {
+		defer s.cli.catchUpMu.Unlock()
+		err := s.catchUpScanLocked()
+		_, _, ready := walletScanTip(s.daemon.Chain(), selected)
+		s.rescanMu.Lock()
+		if s.rescanWallet == selected {
+			s.rescanActive = false
+			if err != nil {
+				s.rescanError = err.Error()
+			} else if !ready {
+				s.rescanError = "scan paused before the local chain tip"
+			}
+		}
+		s.rescanMu.Unlock()
+	}()
+	writeJSON(w, http.StatusAccepted, map[string]any{"status": "rescanning", "from_height": start, "chain_height": chainHeight})
+}
+
+func walletRescanStart(w *wallet.Wallet, chainHeight uint64) uint64 {
+	if birth, known := w.BirthHeight(); known && birth <= chainHeight && birth > MaxReorgDepth {
+		return birth - MaxReorgDepth
+	}
+	return 0
+}
+
+func (s *APIServer) handleWalletRescanStatus(w http.ResponseWriter, r *http.Request) {
+	if !s.requireWallet(w, r) {
+		return
+	}
+	s.walletOpMu.RLock()
+	defer s.walletOpMu.RUnlock()
+	s.mu.RLock()
+	current, locked := s.wallet, s.locked
+	s.mu.RUnlock()
+	if current == nil || locked {
+		writeError(w, http.StatusForbidden, "wallet is locked or unavailable")
+		return
+	}
+	s.rescanMu.Lock()
+	selected, start, active, failure := s.rescanWallet, s.rescanStart, s.rescanActive, s.rescanError
+	s.rescanMu.Unlock()
+	if selected != current {
+		start, active, failure = 0, false, ""
+	}
+	status := "idle"
+	if active {
+		status = "scanning"
+	} else if failure != "" {
+		status = "incomplete"
+	} else if selected == current {
+		status = "local_scan_complete"
+	}
+	writeJSON(w, http.StatusOK, map[string]any{"status": status, "from_height": start,
+		"synced_height": current.SyncedHeight(), "chain_height": s.daemon.Chain().Height(), "error": failure})
+}
