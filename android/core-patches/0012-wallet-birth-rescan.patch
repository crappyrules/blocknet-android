+	w.ResetScanFromHeight(100)
+	if len(w.data.Outputs) != 1 || w.data.Outputs[0].BlockHeight != 99 || w.data.Outputs[0].Spent {
+		t.Fatal("reset did not discard affected outputs and unspend older output")
+	}
+	if w.data.SyncedHeight != 99 || w.data.SyncedHash != ([32]byte{}) {
+		t.Fatal("reset did not mark the scan cursor incomplete")
+	}
+	if w.data.Keys != keys || w.data.BirthHeight == nil || *w.data.BirthHeight != birth ||
+		len(w.data.SendHistory) != 1 || w.data.SendHistory[0] != sent ||
+		len(w.data.PendingCredits) != 1 || w.data.PendingCredits[0] != credit {
