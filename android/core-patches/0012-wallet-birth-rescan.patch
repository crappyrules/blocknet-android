+// BirthHeight is set only when a freshly generated wallet was created at a
+// recently confirmed chain tip. A copy is returned so callers cannot mutate it.
+func (w *Wallet) BirthHeight() (uint64, bool) {
+	w.mu.RLock()
+	defer w.mu.RUnlock()
+	if w.data.BirthHeight == nil {
+		return 0, false
+	}
+	return *w.data.BirthHeight, true
+}
+
+func (w *Wallet) SetBirthHeight(height uint64) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	h := height
+	w.data.BirthHeight = &h
+}
+
+// ScanCheckpoint is an in-memory rollback point for a failed encrypted rescan
+// save. It is never serialized or exposed through the API.
+type ScanCheckpoint struct {
+	outputs []*OwnedOutput
+	height  uint64
+	hash    [32]byte
+}
+
+func (w *Wallet) CaptureScanCheckpoint() ScanCheckpoint {
+	w.mu.RLock()
+	defer w.mu.RUnlock()
+	state := ScanCheckpoint{height: w.data.SyncedHeight, hash: w.data.SyncedHash,
+		outputs: make([]*OwnedOutput, 0, len(w.data.Outputs))}
+	for _, out := range w.data.Outputs {
+		copy := *out
+		state.outputs = append(state.outputs, &copy)
+	}
+	return state
+}
+
+func (w *Wallet) RestoreScanCheckpoint(state ScanCheckpoint) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	w.data.Outputs = state.outputs
+	w.data.SyncedHeight = state.height
+	w.data.SyncedHash = state.hash
+}
+
+// ResetScanFromHeight discards scan results at and above start, including
+// genesis when start is zero. The caller must serialize this with live scans
+// and save the result before reporting that a rescan has begun.
+func (w *Wallet) ResetScanFromHeight(start uint64) {
+	w.mu.Lock()
+	defer w.mu.Unlock()
+	kept := w.data.Outputs[:0]
+	for _, out := range w.data.Outputs {
+		if out.BlockHeight >= start {
+			continue
+		}
+		if out.Spent && out.SpentHeight >= start {
+			out.Spent = false
+			out.SpentHeight = 0
+		}
+		kept = append(kept, out)
+	}
+	w.data.Outputs = kept
+	if start == 0 {
+		w.data.SyncedHeight = 0
+	} else {
+		w.data.SyncedHeight = start - 1
+	}
+	w.data.SyncedHash = [32]byte{}
+}
