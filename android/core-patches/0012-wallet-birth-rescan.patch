+func TestMobileRescanFindsPreviouslySkippedIncomingOutput(t *testing.T) {
+	chain, storage, cleanup := mustCreateTestChain(t)
+	defer cleanup()
+	mustAddGenesisBlock(t, chain)
+	genesis := chain.GetBlockByHeight(0)
+	path := filepath.Join(t.TempDir(), "disposable.wallet")
+	w, err := wallet.NewWallet(path, []byte("disposable-password"), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	keys := w.Keys()
+	reward, err := CreateCoinbase(keys.SpendPubKey, keys.ViewPubKey, GetBlockReward(1), 1)
+	if err != nil {
+		t.Fatal(err)
+	}
+	b1 := &Block{Header: BlockHeader{Version: 1, Height: 1, PrevHash: genesis.Hash(),
+		Timestamp: genesis.Header.Timestamp + BlockIntervalSec, Difficulty: MinDifficulty},
+		Transactions: []*Transaction{reward.Tx}}
+	if err := storage.CommitBlock(&BlockCommit{Block: b1, Height: 1, Hash: b1.Hash(), Work: 2, IsMainTip: true}); err != nil {
+		t.Fatal(err)
+	}
+	chain.mu.Lock()
+	chain.height, chain.bestHash = 1, b1.Hash()
+	chain.publishTipLocked()
+	chain.mu.Unlock()
+	// The old catch-up endpoint would return "already synced" here even
+	// though an owned output in this block had never been discovered.
+	w.SetSyncedTip(1, b1.Hash())
+	if err := w.Save(); err != nil {
+		t.Fatal(err)
+	}
+	d, stop := mustStartTestDaemon(t, chain)
+	defer stop()
+	scanner := wallet.NewScanner(w, defaultScannerConfig())
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	c := &CLI{ctx: ctx, cancel: cancel, daemon: d, wallet: w, scanner: scanner}
+	s := NewAPIServer(d, w, scanner, t.TempDir(), []byte("disposable-password"))
+	s.cli = c
+	rr := httptest.NewRecorder()
+	s.handleWalletRescan(rr, httptest.NewRequest(http.MethodPost, "/api/wallet/rescan", nil))
+	if rr.Code != http.StatusAccepted {
+		t.Fatalf("rescan status %d: %s", rr.Code, rr.Body.String())
+	}
+	c.catchUpMu.Lock()
+	c.catchUpMu.Unlock()
+	if total, _ := w.OutputCount(); total != 1 {
+		t.Fatalf("rescan found %d owned outputs, want 1", total)
+	}
+	reloaded, err := wallet.LoadWallet(path, []byte("disposable-password"), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if total, _ := reloaded.OutputCount(); total != 1 {
+		t.Fatal("recovered output was not durable")
+	}
+}
