+func TestResetScanFromHeightPreservesKeysAndOutgoingHistory(t *testing.T) {
+	birth := uint64(250)
+	keys := StealthKeys{SpendPrivKey: [32]byte{7}, ViewPrivKey: [32]byte{9}}
+	sent := &SendRecord{TxID: [32]byte{8}, Amount: 42}
+	credit := &PendingCredit{}
+	w := &Wallet{data: WalletData{
+		Keys: keys, BirthHeight: &birth,
+		Outputs: []*OwnedOutput{
+			{TxID: [32]byte{1}, BlockHeight: 99, Spent: true, SpentHeight: 150},
+			{TxID: [32]byte{2}, BlockHeight: 100},
+			{TxID: [32]byte{3}, BlockHeight: 200},
+		},
+		SendHistory: []*SendRecord{sent}, PendingCredits: []*PendingCredit{credit},
+		SyncedHeight: 200, SyncedHash: [32]byte{4},
