+func TestMobileRescanStatusSurvivesConcurrentUnload(t *testing.T) {
+	chain, _, cleanup := mustCreateTestChain(t)
+	defer cleanup()
+	mustAddGenesisBlock(t, chain)
+	d, stop := mustStartTestDaemon(t, chain)
+	defer stop()
+	w, err := wallet.NewWallet(filepath.Join(t.TempDir(), "disposable.wallet"), []byte("pw"), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := NewAPIServer(d, w, nil, t.TempDir(), []byte("pw"))
+	s.walletOpMu.Lock()
+	done := make(chan *httptest.ResponseRecorder, 1)
+	go func() {
+		rr := httptest.NewRecorder()
+		s.handleWalletRescanStatus(rr, httptest.NewRequest(http.MethodGet, "/api/wallet/rescan", nil))
+		done <- rr
+	}()
+	s.mu.Lock()
+	s.wallet = nil
+	s.locked = true
+	s.mu.Unlock()
+	s.walletOpMu.Unlock()
+	select {
+	case rr := <-done:
+		if rr.Code == http.StatusOK {
+			t.Fatal("unloaded wallet was reported as active")
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("rescan status blocked on unload")
+	}
+}
