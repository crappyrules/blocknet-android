diff --git a/daemon.go b/daemon.go
index 837be86..31c1bc7 100644
--- a/daemon.go
+++ b/daemon.go
@@ -48,9 +48,11 @@ type Daemon struct {
 	// Identity
 	stealthKeys *StealthKeys
 
-	// Block notifications for wallet auto-sync
-	blockSubs   []chan *Block
-	blockSubsMu sync.Mutex
+	// General block streams can omit events for slow subscribers. The wallet
+	// stream retains the newest event so its gap/reorg path can catch up.
+	blockSubs       []chan *Block
+	walletBlockSubs []chan *Block
+	blockSubsMu     sync.Mutex
 
 	// Mined block notifications (blocks we mined)
 	minedSubs   []chan *Block
@@ -497,6 +499,31 @@ func (d *Daemon) SubscribeBlocks() chan *Block {
 	return ch
 }
 
+// SubscribeWalletBlocks delivers ordered notifications while there is room.
+// On overflow the oldest pending notification is replaced by the newest;
+// wallet scanning detects the resulting height gap and reads canonical blocks.
+func (d *Daemon) SubscribeWalletBlocks() chan *Block {
+	d.blockSubsMu.Lock()
+	defer d.blockSubsMu.Unlock()
+	ch := make(chan *Block, 10)
+	d.walletBlockSubs = append(d.walletBlockSubs, ch)
+	return ch
+}
+
+func (d *Daemon) UnsubscribeWalletBlocks(ch chan *Block) {
+	if ch == nil {
+		return
+	}
+	d.blockSubsMu.Lock()
+	defer d.blockSubsMu.Unlock()
+	for i, sub := range d.walletBlockSubs {
+		if sub == ch {
+			d.walletBlockSubs = append(d.walletBlockSubs[:i], d.walletBlockSubs[i+1:]...)
+			return
+		}
+	}
+}
+
 // UnsubscribeBlocks removes a previously subscribed block channel.
 func (d *Daemon) UnsubscribeBlocks(ch chan *Block) {
 	if ch == nil {
@@ -522,6 +549,20 @@ func (d *Daemon) notifyBlock(block *Block) {
 		default: // Don't block if subscriber is slow
 		}
 	}
+	for _, ch := range d.walletBlockSubs {
+		select {
+		case ch <- block:
+		default:
+			// Delivery is serialized by blockSubsMu. Draining one oldest
+			// pending item leaves room for this newer event; the wallet
+			// reconciles any resulting gap against the canonical chain.
+			select {
+			case <-ch:
+			default: // the receiver drained it concurrently
+			}
+			ch <- block
+		}
+	}
 }
 
 // SubscribeMinedBlocks returns a channel that receives blocks we mined
