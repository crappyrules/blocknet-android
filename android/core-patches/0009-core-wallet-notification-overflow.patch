index 0000000..eb1739b
--- /dev/null
+++ b/wallet_notification_overflow_test.go
@@ -0,0 +1,178 @@
+package main
+
+import (
+	"context"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"blocknet/wallet"
+)
+
+func TestWalletBlockQueueRetainsNewestInOrder(t *testing.T) {
+	d := &Daemon{}
+	ch := d.SubscribeWalletBlocks()
+	defer d.UnsubscribeWalletBlocks(ch)
+	for h := uint64(1); h <= 11; h++ {
+		d.notifyBlock(&Block{Header: BlockHeader{Height: h}})
+	}
+	if len(ch) != 10 {
+		t.Fatalf("queue length %d, want 10", len(ch))
+	}
+	for want := uint64(2); want <= 11; want++ {
+		if got := (<-ch).Header.Height; got != want {
+			t.Fatalf("notification order: got height %d, want %d", got, want)
+		}
+	}
+}
+
+func TestWalletAutoScanRecoversDroppedCanonicalBurst(t *testing.T) {
+	chain, storage, cleanup := mustCreateTestChain(t)
+	defer cleanup()
+	mustAddGenesisBlock(t, chain)
+	genesis := chain.GetBlockByHeight(0)
+	blocks := make([]*Block, 0, 12)
+	prev := genesis.Hash()
+	for h := uint64(1); h <= 12; h++ {
+		block := &Block{Header: BlockHeader{Version: 1, Height: h, PrevHash: prev,
+			Timestamp: genesis.Header.Timestamp + int64(h)*BlockIntervalSec, Difficulty: MinDifficulty}}
+		if err := storage.CommitBlock(&BlockCommit{Block: block, Height: h, Hash: block.Hash(), Work: h + 1, IsMainTip: true}); err != nil {
+			t.Fatal(err)
+		}
+		blocks = append(blocks, block)
+		prev = block.Hash()
+	}
+	chain.mu.Lock()
+	chain.height, chain.bestHash = 12, prev
+	chain.publishTipLocked()
+	chain.mu.Unlock()
+	d, stop := mustStartTestDaemon(t, chain)
+	defer stop()
+	path := filepath.Join(t.TempDir(), "disposable.wallet")
+	w, err := wallet.NewWallet(path, []byte("pw"), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	w.SetSyncedTip(0, genesis.Hash())
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	c := &CLI{ctx: ctx, cancel: cancel, daemon: d, wallet: w,
+		scanner: wallet.NewScanner(w, defaultScannerConfig())}
+	c.scanMu.Lock()
+	done := make(chan struct{})
+	go func() { c.autoScanBlocks(); close(done) }()
+	deadline := time.Now().Add(10 * time.Second)
+	var ch chan *Block
+	for ch == nil {
+		d.blockSubsMu.Lock()
+		if len(d.walletBlockSubs) == 1 {
+			ch = d.walletBlockSubs[0]
+		}
+		d.blockSubsMu.Unlock()
+		if time.Now().After(deadline) {
+			c.scanMu.Unlock()
+			t.Fatal("wallet subscriber did not start")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	d.notifyBlock(blocks[0])
+	for len(ch) != 0 { // the scanner has taken block 1 and is waiting on scanMu
+		if time.Now().After(deadline) {
+			c.scanMu.Unlock()
+			t.Fatal("scanner did not take first notification")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	for _, block := range blocks[1:] { // eleven notifications into a ten-slot queue
+		d.notifyBlock(block)
+	}
+	// A delayed notifier can arrive out of height order. Replace the queued
+	// height-12 wake-up with an ordered run ending at 11; live scanning must
+	// still notice the canonical tip after consuming a forward event.
+	for _, block := range blocks[1:11] {
+		d.notifyBlock(block)
+	}
+	if len(ch) != 10 {
+		c.scanMu.Unlock()
+		t.Fatalf("wallet queue has %d pending notifications, want 10", len(ch))
+	}
+	if _, _, ready := walletScanTip(chain, w); ready {
+		c.scanMu.Unlock()
+		t.Fatal("wallet was marked send-ready before queued blocks were scanned")
+	}
+	c.scanMu.Unlock()
+	for w.SyncedHeight() != 12 || w.SyncedHash() != blocks[11].Hash() {
+		if time.Now().After(deadline) {
+			t.Fatalf("wallet stopped at height %d hash %x", w.SyncedHeight(), w.SyncedHash())
+		}
+		time.Sleep(time.Millisecond)
+	}
+	if _, _, ready := walletScanTip(chain, w); !ready {
+		t.Fatal("wallet remained unavailable after overflow recovery")
+	}
+	if got := len(w.AllOutputs()); got != 0 {
+		t.Fatalf("empty canonical chain produced %d wallet outputs", got)
+	}
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(10 * time.Second):
+		t.Fatal("wallet scanner did not stop")
+	}
+	d.blockSubsMu.Lock()
+	remaining := len(d.walletBlockSubs)
+	d.blockSubsMu.Unlock()
+	if remaining != 0 {
+		t.Fatal("wallet block subscription was not removed on shutdown")
+	}
+	reloaded, err := wallet.LoadWallet(path, []byte("pw"), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if reloaded.SyncedHeight() != 12 || reloaded.SyncedHash() != blocks[11].Hash() {
+		t.Fatal("overflow recovery did not persist the canonical tip")
+	}
+}
+
+func TestWalletBlockOverflowReorgAndSideBranch(t *testing.T) {
+	chain, storage, cleanup := mustCreateTestChain(t)
+	defer cleanup()
+	mustAddGenesisBlock(t, chain)
+	a, b := makeForkBlocksForWalletTest(t, chain, storage)
+	w, err := wallet.NewWallet(filepath.Join(t.TempDir(), "disposable.wallet"), []byte("pw"), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	w.AddOutput(&wallet.OwnedOutput{TxID: [32]byte{9}, OutputIndex: 0, Amount: 7, BlockHeight: 1})
+	w.SetSyncedTip(1, a.Hash())
+	reorgWalletTestChain(t, chain, storage, a, b)
+	if _, _, ready := walletScanTip(chain, w); ready {
+		t.Fatal("orphaned wallet was marked send-ready")
+	}
+	d := &Daemon{}
+	ch := d.SubscribeWalletBlocks()
+	defer d.UnsubscribeWalletBlocks(ch)
+	for i := 0; i < 10; i++ {
+		d.notifyBlock(a)
+	}
+	d.notifyBlock(b)
+	side := &Block{Header: BlockHeader{Version: 1, Height: 1, PrevHash: a.Header.PrevHash,
+		Timestamp: a.Header.Timestamp + 2, Difficulty: MinDifficulty}}
+	d.notifyBlock(side)
+	if len(ch) != 10 {
+		t.Fatal("reorg burst was not bounded to ten notifications")
+	}
+	scanner := wallet.NewScanner(w, defaultScannerConfig())
+	for len(ch) > 0 {
+		applyBlockToWallet(chain, w, scanner, <-ch)
+	}
+	if w.SyncedHeight() != 1 || w.SyncedHash() != b.Hash() {
+		t.Fatal("overflow reorg did not reach the canonical tip")
+	}
+	if got := len(w.AllOutputs()); got != 0 {
+		t.Fatalf("orphaned output survived overflow reorg: %d", got)
+	}
+	if _, _, ready := walletScanTip(chain, w); !ready {
+		t.Fatal("recovered wallet is not send-ready")
+	}
+}
