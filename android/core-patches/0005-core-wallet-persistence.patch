@@ -0,0 +1,130 @@
+package wallet
+
+import (
+	"bytes"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestAtomicReplaceWalletFilePreservesOldBytesOnInterruptedWrite(t *testing.T) {
+	filename := filepath.Join(t.TempDir(), "disposable.wallet")
+	old := []byte("old encrypted wallet")
+	if err := os.WriteFile(filename, old, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	stages := []struct {
+		name         string
+		write        func(*os.File, []byte) (int, error)
+		beforeRename func() error
+	}{
+		{"short write", func(f *os.File, b []byte) (int, error) { return f.Write(b[:len(b)/2]) }, nil},
+		{"interrupted before rename", nil, func() error { return errors.New("injected interruption") }},
+	}
+	for _, stage := range stages {
+		t.Run(stage.name, func(t *testing.T) {
+			if err := atomicReplaceWalletFile(filename, []byte("new encrypted wallet"), stage.write, stage.beforeRename); err == nil {
+				t.Fatal("injected failure returned success")
+			}
+			got, err := os.ReadFile(filename)
+			if err != nil || !bytes.Equal(got, old) {
+				t.Fatalf("old wallet changed: %q, %v", got, err)
+			}
+		})
+	}
+}
+
+func TestWalletSaveRejectsMnemonicRereadFailureAndPreservesFile(t *testing.T) {
+	cfg := testWalletConfigNoCryptoDeps(t)
+	filename := filepath.Join(t.TempDir(), "disposable.wallet")
+	mnemonic, err := GenerateMnemonic()
+	if err != nil {
+		t.Fatal(err)
+	}
+	password := []byte("disposable-password")
+	w, err := NewWalletFromMnemonic(filename, password, mnemonic, cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	old, err := os.ReadFile(filename)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// A wrong in-memory password simulates a deterministic decrypt failure of
+	// the prior file, without damaging the fixture we need to verify afterward.
+	w.mu.Lock()
+	w.password = []byte("wrong-password")
+	w.mu.Unlock()
+	if err := w.Save(); err == nil {
+		t.Fatal("save discarded an expected recovery phrase")
+	}
+	w.mu.Lock()
+	w.password = cloneBytes(password)
+	w.mu.Unlock()
+	got, err := os.ReadFile(filename)
+	if err != nil || !bytes.Equal(got, old) {
+		t.Fatalf("failed save changed encrypted file: %v", err)
+	}
+	loaded, err := LoadWallet(filename, password, cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	phrase, err := loaded.Mnemonic()
+	if err != nil || phrase != mnemonic {
+		t.Fatalf("recovery phrase changed: %v", err)
+	}
+}
+
+func TestWalletConcurrentSavesAndMutationReloadNewestState(t *testing.T) {
+	cfg := testWalletConfigNoCryptoDeps(t)
+	filename := filepath.Join(t.TempDir(), "disposable.wallet")
+	password := []byte("disposable-password")
+	var keys StealthKeys
+	keys.SpendPubKey[0] = 1
+	w, err := NewWalletFromStealthKeys(filename, password, keys, cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	firstReady, releaseFirst := make(chan struct{}), make(chan struct{})
+	first := true
+	w.beforeSaveReplace = func() error {
+		if first {
+			first = false
+			close(firstReady)
+			<-releaseFirst
+		}
+		return nil
+	}
+	w.SetSyncedTip(1, [32]byte{1})
+	firstDone := make(chan error, 1)
+	go func() { firstDone <- w.Save() }()
+	select {
+	case <-firstReady:
+	case <-time.After(5 * time.Second):
+		t.Fatal("first save did not reach replace barrier")
+	}
+	w.SetSyncedTip(2, [32]byte{2})
+	secondDone := make(chan error, 1)
+	go func() { secondDone <- w.Save() }()
+	select {
+	case err := <-secondDone:
+		t.Fatalf("second save passed the first save: %v", err)
+	case <-time.After(20 * time.Millisecond):
+	}
+	close(releaseFirst)
+	if err := <-firstDone; err != nil {
+		t.Fatal(err)
+	}
+	if err := <-secondDone; err != nil {
+		t.Fatal(err)
+	}
+	loaded, err := LoadWallet(filename, password, cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if loaded.SyncedHeight() != 2 || loaded.SyncedHash() != ([32]byte{2}) {
+		t.Fatalf("latest wallet state not durable: %d %x", loaded.SyncedHeight(), loaded.SyncedHash())
+	}
+}
