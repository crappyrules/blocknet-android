diff --git a/daemon_sync_wallet_notification_test.go b/daemon_sync_wallet_notification_test.go
new file mode 100644
index 0000000..4436a1b
--- /dev/null
+++ b/daemon_sync_wallet_notification_test.go
@@ -0,0 +1,124 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"blocknet/protocol/params"
+	"blocknet/wallet"
+)
+
+// Fetched sync blocks must wake the loaded wallet scanner exactly once each.
+// The two static blocks were mined on disposable testnet data and are validated
+// by the normal ProcessBlock path; no network or funded wallet is involved.
+func TestFetchedSyncBlocksAdvanceWalletAndPersistOnStop(t *testing.T) {
+	params.InitTestnet()
+	encoded, err := os.ReadFile("testdata/sync_wallet_fixture_testnet.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var blocks []*Block
+	if err := json.Unmarshal(encoded, &blocks); err != nil || len(blocks) != 2 {
+		t.Fatalf("invalid two-block testnet fixture: %v", err)
+	}
+	d, err := NewDaemon(DaemonConfig{DataDir: t.TempDir(), MobileClient: true,
+		AllowOfflineStart: true, FullSync: true}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = d.Stop() }()
+	genesis := d.Chain().GetBlockByHeight(0)
+	if genesis == nil {
+		t.Fatal("testnet genesis is unavailable")
+	}
+	path := filepath.Join(t.TempDir(), "disposable.wallet")
+	w, err := wallet.NewWallet(path, []byte("synthetic-password"), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	w.SetSyncedTip(0, genesis.Hash())
+	if err := w.Save(); err != nil {
+		t.Fatal(err)
+	}
+	observed := d.SubscribeWalletBlocks()
+	defer d.UnsubscribeWalletBlocks(observed)
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	c := &CLI{ctx: ctx, cancel: cancel, daemon: d, wallet: w,
+		scanner: wallet.NewScanner(w, defaultScannerConfig())}
+	done := make(chan struct{})
+	go func() { c.autoScanBlocks(); close(done) }()
+	deadline := time.Now().Add(10 * time.Second)
+	for {
+		d.blockSubsMu.Lock()
+		subscribers := len(d.walletBlockSubs)
+		d.blockSubsMu.Unlock()
+		if subscribers == 2 {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("wallet scanner did not subscribe")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	for _, block := range blocks {
+		data, err := json.Marshal(block)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := d.processBlockData(data); err != nil {
+			t.Fatalf("fetched block was rejected: %v", err)
+		}
+	}
+	if d.Chain().Height() != 2 {
+		t.Fatalf("chain height=%d, want 2", d.Chain().Height())
+	}
+	if len(observed) != 2 {
+		t.Fatalf("wallet subscriber received %d fetched blocks, want 2", len(observed))
+	}
+	for want := uint64(1); want <= 2; want++ {
+		if got := (<-observed).Header.Height; got != want {
+			t.Fatalf("wallet notification height=%d, want %d", got, want)
+		}
+	}
+	duplicate, err := json.Marshal(blocks[0])
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := d.processBlockData(duplicate); !errors.Is(err, ErrDuplicateBlock) {
+		t.Fatalf("duplicate block error=%v, want ErrDuplicateBlock", err)
+	}
+	if err := d.processBlockData([]byte("{}")); err == nil {
+		t.Fatal("invalid block was accepted")
+	}
+	if len(observed) != 0 {
+		t.Fatal("duplicate or invalid block notified the wallet")
+	}
+	for w.SyncedHeight() != 2 || w.SyncedHash() != blocks[1].Hash() {
+		if time.Now().After(deadline) {
+			t.Fatalf("wallet scan remained at height %d", w.SyncedHeight())
+		}
+		time.Sleep(time.Millisecond)
+	}
+	if _, _, ready := walletScanTip(d.Chain(), w); !ready {
+		t.Fatal("wallet scan did not reach the canonical tip")
+	}
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(10 * time.Second):
+		t.Fatal("wallet scanner did not stop")
+	}
+	reloaded, err := wallet.LoadWallet(path, []byte("synthetic-password"), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if reloaded.SyncedHeight() != 2 || reloaded.SyncedHash() != blocks[1].Hash() {
+		t.Fatal("wallet scan tip was not durable after stop")
+	}
+}
