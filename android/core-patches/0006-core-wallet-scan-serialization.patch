+func TestApplyBlockToWalletIgnoresStaleCanonicalEvent(t *testing.T) {
+	chain, _, cleanup := mustCreateTestChain(t)
+	defer cleanup()
+	mustAddGenesisBlock(t, chain)
+	genesis := chain.GetBlockByHeight(0)
+	w, err := wallet.NewWallet(filepath.Join(t.TempDir(), "disposable.wallet"), []byte("pw"), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	w.SetSyncedTip(0, genesis.Hash())
+	applyBlockToWallet(chain, w, wallet.NewScanner(w, defaultScannerConfig()), genesis)
+	if w.SyncedHeight() != 0 || w.SyncedHash() != genesis.Hash() {
+		t.Fatal("stale canonical event rewound the wallet scan tip")
+	}
+}
+
+func TestAutoScanDropsPendingSaveAfterWalletUnload(t *testing.T) {
+	chain, _, cleanup := mustCreateTestChain(t)
+	defer cleanup()
+	mustAddGenesisBlock(t, chain)
+	genesis := chain.GetBlockByHeight(0)
+	d, stop := mustStartTestDaemon(t, chain)
+	defer stop()
+	path := filepath.Join(t.TempDir(), "disposable.wallet")
+	w, err := wallet.NewWallet(path, []byte("pw"), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	c := &CLI{ctx: ctx, cancel: cancel, daemon: d, wallet: w,
+		scanner: wallet.NewScanner(w, defaultScannerConfig())}
+	done := make(chan struct{})
+	go func() { c.autoScanBlocks(); close(done) }()
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		d.blockSubsMu.Lock()
+		ready := len(d.blockSubs) > 0
+		d.blockSubsMu.Unlock()
+		if ready {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("live subscriber did not start")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	d.notifyBlock(genesis)
+	for w.SyncedHash() != genesis.Hash() {
+		if time.Now().After(deadline) {
+			t.Fatal("live scan did not anchor genesis")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	// Unload commits the old instance, then another instance updates the same
+	// encrypted file. The delayed live-scan batch must not replace its bytes.
+	c.scanMu.Lock()
+	if err := w.Save(); err != nil {
+		c.scanMu.Unlock()
+		t.Fatal(err)
+	}
+	c.mu.Lock()
+	c.wallet, c.scanner = nil, nil
+	c.mu.Unlock()
+	c.scanMu.Unlock()
+	other, err := wallet.LoadWallet(path, []byte("pw"), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	want := [32]byte{42}
+	other.SetSyncedTip(1, want)
+	if err := other.Save(); err != nil {
+		t.Fatal(err)
+	}
+	cancel()
+	select {
+	case <-done:
+	case <-time.After(5 * time.Second):
+		t.Fatal("live scan did not stop")
+	}
+	reloaded, err := wallet.LoadWallet(path, []byte("pw"), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if reloaded.SyncedHeight() != 1 || reloaded.SyncedHash() != want {
+		t.Fatal("unloaded live-scan instance overwrote the newer wallet file")
+	}
+}
+
+func TestCatchUpAnchorsUnhashedGenesisForReadiness(t *testing.T) {
+	chain, _, cleanup := mustCreateTestChain(t)
+	defer cleanup()
+	mustAddGenesisBlock(t, chain)
+	d, stop := mustStartTestDaemon(t, chain)
+	defer stop()
+	path := filepath.Join(t.TempDir(), "disposable.wallet")
+	w, err := wallet.NewWallet(path, []byte("pw"), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if w.SyncedHash() != ([32]byte{}) {
+		t.Fatal("fixture was already anchored")
+	}
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	c := &CLI{ctx: ctx, cancel: cancel, daemon: d, wallet: w}
+	s := NewAPIServer(d, w, wallet.NewScanner(w, defaultScannerConfig()), t.TempDir(), []byte("pw"))
+	s.cli = c
+	s.catchUpScan()
+	want := chain.GetBlockByHeight(0).Hash()
+	if w.SyncedHeight() != 0 || w.SyncedHash() != want {
+		t.Fatal("genesis remained unanchored")
+	}
+	loaded, err := wallet.LoadWallet(path, []byte("pw"), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if loaded.SyncedHash() != want {
+		t.Fatal("genesis anchor was not durable")
+	}
+}
