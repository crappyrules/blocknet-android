+func TestCatchUpAndLiveScanSerializeAndReload(t *testing.T) {
+	chain, storage, cleanup := mustCreateTestChain(t)
+	defer cleanup()
+	mustAddGenesisBlock(t, chain)
+	genesis := chain.GetBlockByHeight(0)
+	makeBlock := func(height uint64, prev [32]byte) *Block {
+		return &Block{Header: BlockHeader{Version: 1, Height: height, PrevHash: prev,
+			Timestamp: genesis.Header.Timestamp + int64(height)*BlockIntervalSec, Difficulty: MinDifficulty}}
+	}
+	b1 := makeBlock(1, genesis.Hash())
+	b2 := makeBlock(2, b1.Hash())
+	for _, block := range []*Block{b1, b2} {
+		if err := storage.CommitBlock(&BlockCommit{Block: block, Height: block.Header.Height,
+			Hash: block.Hash(), Work: block.Header.Height + 1, IsMainTip: true}); err != nil {
+			t.Fatal(err)
+		}
+	}
+	chain.mu.Lock()
+	chain.height, chain.bestHash = 2, b2.Hash()
+	chain.publishTipLocked()
+	chain.mu.Unlock()
+	d, stop := mustStartTestDaemon(t, chain)
+	defer stop()
+	path := filepath.Join(t.TempDir(), "disposable.wallet")
+	w, err := wallet.NewWallet(path, []byte("pw"), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	w.SetSyncedTip(0, genesis.Hash())
+	scanner := wallet.NewScanner(w, defaultScannerConfig())
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	c := &CLI{ctx: ctx, cancel: cancel, daemon: d, wallet: w, scanner: scanner}
+	s := NewAPIServer(d, w, scanner, t.TempDir(), []byte("pw"))
+	s.cli = c
+
+	// Hold the scan coordinator while catch-up and a live event arrive. Neither
+	// path may change the compound wallet scan state until the owner releases it.
+	c.scanMu.Lock()
+	catchDone, liveDone := make(chan struct{}), make(chan struct{})
+	go func() { s.catchUpScan(); close(catchDone) }()
+	go func() { c.autoScanBlocks(); close(liveDone) }()
+	deadline := time.Now().Add(5 * time.Second)
+	for {
+		d.blockSubsMu.Lock()
+		ready := len(d.blockSubs) > 0
+		d.blockSubsMu.Unlock()
+		if ready {
+			break
+		}
+		if time.Now().After(deadline) {
+			c.scanMu.Unlock()
+			t.Fatal("live subscriber did not start")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	d.notifyBlock(b2)
+	if w.SyncedHeight() != 0 {
+		c.scanMu.Unlock()
+		t.Fatal("scan advanced while coordinator was held")
+	}
+	c.scanMu.Unlock()
+
+	select {
+	case <-catchDone:
+	case <-time.After(10 * time.Second):
+		t.Fatal("catch-up did not complete")
+	}
+	deadline = time.Now().Add(10 * time.Second)
+	for w.SyncedHeight() != 2 {
+		if time.Now().After(deadline) {
+			t.Fatalf("wallet stopped at height %d", w.SyncedHeight())
+		}
+		time.Sleep(time.Millisecond)
+	}
+	cancel()
+	select {
+	case <-liveDone:
+	case <-time.After(10 * time.Second):
+		t.Fatal("live scan did not stop")
+	}
+	if w.SyncedHash() != b2.Hash() {
+		t.Fatal("wallet tip is not canonical block 2")
+	}
+	if err := w.Save(); err != nil {
+		t.Fatal(err)
+	}
+	loaded, err := wallet.LoadWallet(path, []byte("pw"), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if loaded.SyncedHeight() != 2 || loaded.SyncedHash() != b2.Hash() {
+		t.Fatal("serialized scan tip was not durable across restart")
+	}
+}
