+func TestExplicitSyncRepairsSameHeightForkForReadiness(t *testing.T) {
+	chain, storage, cleanup := mustCreateTestChain(t)
+	defer cleanup()
+	mustAddGenesisBlock(t, chain)
+	genesis := chain.GetBlockByHeight(0)
+	b1 := &Block{Header: BlockHeader{Version: 1, Height: 1, PrevHash: genesis.Hash(),
+		Timestamp: genesis.Header.Timestamp + BlockIntervalSec, Difficulty: MinDifficulty}}
+	if err := storage.CommitBlock(&BlockCommit{Block: b1, Height: 1, Hash: b1.Hash(), Work: 2, IsMainTip: true}); err != nil {
+		t.Fatal(err)
+	}
+	chain.mu.Lock()
+	chain.height, chain.bestHash = 1, b1.Hash()
+	chain.publishTipLocked()
+	chain.mu.Unlock()
+	d, stop := mustStartTestDaemon(t, chain)
+	defer stop()
+	path := filepath.Join(t.TempDir(), "disposable.wallet")
+	w, err := wallet.NewWallet(path, []byte("pw"), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	w.AddOutput(&wallet.OwnedOutput{TxID: [32]byte{9}, OutputIndex: 0, Amount: 5, BlockHeight: 1})
+	w.SetSyncedTip(1, [32]byte{0xff})
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	c := &CLI{ctx: ctx, cancel: cancel, daemon: d, wallet: w}
+	s := NewAPIServer(d, w, wallet.NewScanner(w, defaultScannerConfig()), t.TempDir(), []byte("pw"))
+	s.cli = c
+	response := httptest.NewRecorder()
+	s.handleWalletSync(response, httptest.NewRequest(http.MethodPost, "/api/wallet/sync", nil))
+	if response.Code != http.StatusOK || !bytes.Contains(response.Body.Bytes(), []byte(`"scanning"`)) {
+		t.Fatalf("same-height mismatch was dismissed: %d %s", response.Code, response.Body.String())
+	}
+	deadline := time.Now().Add(10 * time.Second)
+	for w.SyncedHash() != b1.Hash() {
+		if time.Now().After(deadline) {
+			t.Fatal("same-height fork was not repaired")
+		}
+		time.Sleep(time.Millisecond)
+	}
+	if outputs := w.AllOutputs(); len(outputs) != 0 {
+		t.Fatalf("stale fork outputs survived: %d", len(outputs))
+	}
+	// catch-up saves after repair; wait for that completion before reload.
+	c.catchUpMu.Lock()
+	c.catchUpMu.Unlock()
+	loaded, err := wallet.LoadWallet(path, []byte("pw"), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if loaded.SyncedHash() != b1.Hash() {
+		t.Fatal("repaired tip was not durable")
+	}
+}
