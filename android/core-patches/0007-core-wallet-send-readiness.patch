@@ -0,0 +1,141 @@
+package main
+
+import (
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"blocknet/wallet"
+)
+
+func TestWalletScanTipRequiresExactCanonicalTip(t *testing.T) {
+	w, err := wallet.NewWallet(filepath.Join(t.TempDir(), "wallet.dat"), []byte("password"), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	chain := &Chain{}
+	tipHash := [32]byte{0xa1}
+	chain.tipSnap.Store(&tipSnapshot{height: 101, bestHash: tipHash})
+
+	for lag := uint64(1); lag <= 100; lag++ {
+		w.SetSyncedTip(101-lag, [32]byte{0xb2})
+		if _, _, ready := walletScanTip(chain, w); ready {
+			t.Fatalf("wallet %d blocks behind was marked ready", lag)
+		}
+	}
+	w.SetSyncedTip(101, [32]byte{0xb2})
+	if _, _, ready := walletScanTip(chain, w); ready {
+		t.Fatal("same-height different-hash wallet was marked ready")
+	}
+	w.SetSyncedHeight(101)
+	if _, _, ready := walletScanTip(chain, w); ready {
+		t.Fatal("legacy zero-hash wallet was marked ready")
+	}
+	w.SetSyncedTip(101, tipHash)
+	if _, _, ready := walletScanTip(chain, w); !ready {
+		t.Fatal("exactly synced wallet was not ready")
+	}
+}
+
+func TestWalletReadinessHandlersGateLagAndAllowSynced(t *testing.T) {
+	chain, _, cleanup := mustCreateTestChain(t)
+	defer cleanup()
+	mustAddGenesisBlock(t, chain)
+	chain.mu.Lock()
+	chain.height = 101
+	chain.bestHash = [32]byte{0xa1}
+	chain.publishTipLocked()
+	chain.mu.Unlock()
+	d, stop := mustStartTestDaemon(t, chain)
+	defer stop()
+
+	w, err := wallet.NewWallet(filepath.Join(t.TempDir(), "wallet.dat"), []byte("password"), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	recipient, err := wallet.NewWallet(filepath.Join(t.TempDir(), "recipient.dat"), []byte("password"), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	api := NewAPIServer(d, w, nil, t.TempDir(), []byte("password"))
+
+	balance := func() bool {
+		t.Helper()
+		rr := mustMakeHTTPJSONRequest(t, http.HandlerFunc(api.handleBalance), http.MethodGet, "/api/wallet/balance", nil, nil)
+		if rr.Code != http.StatusOK {
+			t.Fatalf("balance status %d: %s", rr.Code, rr.Body.String())
+		}
+		var body struct {
+			Scanning bool `json:"scanning"`
+		}
+		if err := json.Unmarshal(rr.Body.Bytes(), &body); err != nil {
+			t.Fatal(err)
+		}
+		return body.Scanning
+	}
+	requestID := 20
+	send := func(advanced bool) int {
+		t.Helper()
+		path := "/api/wallet/send"
+		body := fmt.Sprintf(`{"recipients":[{"address":%q,"amount":1}],"dry_run":true}`, recipient.Address())
+		handler := api.handleSend
+		if advanced {
+			path = "/api/wallet/send/advanced"
+			body = fmt.Sprintf(`{"recipients":[{"address":%q,"amount":1}],"inputs":[{"txid":%q,"output_index":0}],"dry_run":true}`, recipient.Address(), strings.Repeat("0", 64))
+			handler = api.handleSendAdvanced
+		}
+		rr := httptest.NewRecorder()
+		req := httptest.NewRequest(http.MethodPost, path, strings.NewReader(body))
+		requestID++
+		req.RemoteAddr = fmt.Sprintf("198.51.100.%d:1234", requestID)
+		handler(rr, req)
+		return rr.Code
+	}
+
+	for _, lag := range []uint64{1, 50, 100} {
+		w.SetSyncedTip(101-lag, [32]byte{0xb2})
+		if !balance() || send(false) != http.StatusServiceUnavailable || send(true) != http.StatusServiceUnavailable {
+			t.Fatalf("wallet lag %d was not gated by balance and both send routes", lag)
+		}
+	}
+	w.SetSyncedTip(101, [32]byte{0xb2})
+	if !balance() || send(false) != http.StatusServiceUnavailable {
+		t.Fatal("same-height reorg was not gated")
+	}
+	w.SetSyncedTip(101, [32]byte{0xa1})
+	if balance() {
+		t.Fatal("exactly synced wallet still reports scanning")
+	}
+	if got := send(false); got != http.StatusBadRequest {
+		t.Fatalf("synced send did not reach ordinary insufficient-funds validation: %d", got)
+	}
+}
+
+func TestCreateWalletAnchorsExactTipForReadiness(t *testing.T) {
+	chain, _, cleanup := mustCreateTestChain(t)
+	defer cleanup()
+	mustAddGenesisBlock(t, chain)
+	chain.mu.Lock()
+	chain.height = 3
+	chain.bestHash = [32]byte{0xc3}
+	chain.publishTipLocked()
+	chain.mu.Unlock()
+	d, stop := mustStartTestDaemon(t, chain)
+	defer stop()
+
+	api := NewAPIServer(d, nil, nil, t.TempDir(), nil)
+	api.cli = &CLI{walletFile: filepath.Join(t.TempDir(), "new.wallet.dat")}
+	rr := mustMakeHTTPJSONRequest(t, http.HandlerFunc(api.handleCreateWallet), http.MethodPost,
+		"/api/wallet/create", []byte(`{"password":"disposable-password"}`),
+		map[string]string{"Content-Type": "application/json"})
+	if rr.Code != http.StatusOK {
+		t.Fatalf("create status %d: %s", rr.Code, rr.Body.String())
+	}
+	if height, hash, ready := walletScanTip(chain, api.wallet); !ready || height != 3 || hash != ([32]byte{0xc3}) {
+		t.Fatalf("new wallet did not anchor exact tip: height=%d hash=%x ready=%v", height, hash, ready)
+	}
+}
