diff --git a/api_wallet_readiness.go b/api_wallet_readiness.go
new file mode 100644
index 0000000..5c39022
--- /dev/null
+++ b/api_wallet_readiness.go
@@ -0,0 +1,32 @@
+package main
+
+import "blocknet/wallet"
+
+// walletScanTip reports whether the wallet has scanned the exact canonical tip.
+// Compare the hash as well as the height: a same-height reorg can replace the
+// blocks that supplied wallet outputs. The second snapshot makes concurrent tip
+// or wallet progress changes conservatively report not ready.
+func walletScanTip(chain *Chain, w *wallet.Wallet) (height uint64, hash [32]byte, ready bool) {
+	if chain == nil || w == nil {
+		return 0, [32]byte{}, false
+	}
+	height, hash, _ = chain.TipFast()
+	walletHeight := w.SyncedHeight()
+	walletHash := w.SyncedHash()
+	if walletHeight != height || walletHash != hash {
+		return height, hash, false
+	}
+	againHeight, againHash, _ := chain.TipFast()
+	return height, hash, againHeight == height && againHash == hash &&
+		w.SyncedHeight() == walletHeight && w.SyncedHash() == walletHash
+}
+
+// walletSendTip also requires the network sync run to have ended. There is no
+// tolerated block lag for spending; a fresh output/spend can be in any block.
+func (s *APIServer) walletSendTip() (height uint64, hash [32]byte, ready bool) {
+	if s == nil || s.daemon == nil || s.daemon.Chain() == nil ||
+		(s.daemon.syncMgr != nil && s.daemon.syncMgr.IsSyncing()) {
+		return 0, [32]byte{}, false
+	}
+	return walletScanTip(s.daemon.Chain(), s.wallet)
+}
