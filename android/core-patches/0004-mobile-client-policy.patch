@@ -0,0 +1,89 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+
+	"blocknet/p2p"
+)
+
+func TestMobileClientRejectsMining(t *testing.T) {
+	for _, cfg := range []DaemonConfig{
+		{MobileClient: true, EnableMining: true},
+		{MobileClient: true, SeedMode: true},
+	} {
+		if _, err := NewDaemon(cfg, nil); err == nil {
+			t.Fatalf("mobile configuration accepted mining or seed mode: %+v", cfg)
+		}
+	}
+	nodeCfg := p2p.DefaultNodeConfig()
+	nodeCfg.MobileClient = true
+	node, err := p2p.NewNode(nodeCfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = node.Stop() }()
+	daemon := &Daemon{node: node}
+	daemon.StartMining() // Must return before accessing an uninitialized miner.
+	server := &APIServer{daemon: daemon}
+	response := httptest.NewRecorder()
+	server.handleMiningStart(response, httptest.NewRequest(http.MethodPost, "/api/mining/start", nil))
+	if response.Code != http.StatusForbidden {
+		t.Fatalf("mobile mining route returned %d: %s", response.Code, response.Body.String())
+	}
+}
+
+func TestMobileSettingsRemainOlderCoreCompatible(t *testing.T) {
+	dir := t.TempDir()
+	settings := defaultSettings()
+	settings.Seed = false
+	if err := saveSettings(dir, settings); err != nil {
+		t.Fatal(err)
+	}
+	data, err := os.ReadFile(filepath.Join(dir, settingsFilename))
+	if err != nil {
+		t.Fatal(err)
+	}
+	var fields map[string]json.RawMessage
+	if err := json.Unmarshal(data, &fields); err != nil {
+		t.Fatal(err)
+	}
+	// The pinned older Core rejects unknown JSON fields. The mobile policy is
+	// supplied by the child-process environment, never saved in this file.
+	for _, name := range []string{"mobile_client", "allow_offline_start"} {
+		if _, found := fields[name]; found {
+			t.Fatalf("persistent setting %q breaks rollback", name)
+		}
+	}
+	if _, _, err := loadSettings(dir); err != nil {
+		t.Fatalf("older settings contract rejected file: %v", err)
+	}
+}
+
+func TestMobileDaemonNoListenerOrSeedHTTPAndRestartsDurably(t *testing.T) {
+	dir := t.TempDir()
+	cfg := DaemonConfig{DataDir: dir, ListenAddrs: []string{"/ip4/127.0.0.1/tcp/0"},
+		MobileClient: true, AllowOfflineStart: true, FullSync: true}
+	for attempt := 0; attempt < 2; attempt++ {
+		daemon, err := NewDaemon(cfg, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if err := daemon.Start(); err != nil {
+			t.Fatal(err)
+		}
+		if len(daemon.node.Host().Network().ListenAddresses()) != 0 || daemon.peerIDServer != nil {
+			t.Fatal("mobile daemon opened a P2P or peer-ID listener")
+		}
+		if !daemon.chain.HasGenesis() {
+			t.Fatal("chain state missing after restart")
+		}
+		if err := daemon.Stop(); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
