+
+// The desktop opens every stream over the connection that the mobile node dialed.
+// A no-listen host alone would not stop requests on that connection.
+func TestMobileClientOutboundConnectionDoesNotServe(t *testing.T) {
+	cfg := DefaultNodeConfig()
+	cfg.MobileClient = true
+	cfg.AllowOfflineStart = true
+	cfg.SeedNodes = nil
+	mobile, err := NewNode(cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = mobile.Stop() }()
+	desktop := mustNewTestNode(t)
+	defer func() { _ = desktop.Stop() }()
+	if got := len(mobile.host.Network().ListenAddresses()); got != 0 {
+		t.Fatalf("mobile host has %d listen addresses", got)
+	}
+	if got := len(mobile.Addrs()); got != 0 {
+		t.Fatalf("mobile host advertises %d addresses", got)
+	}
+	mustConnectNodes(t, mobile, desktop)
+	if got := len(desktop.host.Network().ConnsToPeer(mobile.PeerID())); got != 1 {
+		t.Fatalf("expected one phone-initiated connection, got %d", got)
+	}
+
+	var served atomic.Int32
+	var accepted atomic.Int32
+	status := ChainStatus{Height: 3, TotalWork: 3, NetworkID: params.NetworkID, ChainID: params.ChainID}
+	mobileSync := NewSyncManager(mobile, SyncConfig{
+		GetStatus:         func() ChainStatus { return status },
+		GetHeaders:        func(uint64, int) ([][]byte, error) { served.Add(1); return [][]byte{[]byte("header")}, nil },
+		GetBlocks:         func([][32]byte) ([][]byte, error) { served.Add(1); return [][]byte{[]byte("block")}, nil },
+		GetBlocksByHeight: func(uint64, int) ([][]byte, error) { served.Add(1); return [][]byte{[]byte("block")}, nil },
+		GetMempool:        func() [][]byte { served.Add(1); return [][]byte{[]byte("tx")} },
+		ProcessBlock:      func([]byte) error { accepted.Add(1); return nil },
+	})
+	mobileSync.ctx = context.Background()
+	mobile.host.SetStreamHandler(protocolID(params.ProtocolSync), mobileSync.HandleStream)
+	requests := []struct {
+		name string
+		typ  byte
+		data []byte
+	}{
+		{"headers", SyncMsgGetHeaders, []byte(`{"start_height":0,"max_headers":1}`)},
+		{"blocks", SyncMsgGetBlocks, []byte(`{"hashes":[]}`)},
+		{"blocks_by_height", SyncMsgGetBlocksByHeight, []byte(`{"start_height":0,"max_blocks":1}`)},
+		{"mempool", SyncMsgGetMempool, nil},
+	}
+	for _, req := range requests {
+		t.Run(req.name, func(t *testing.T) {
+			ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+			defer cancel()
+			stream, err := desktop.host.NewStream(ctx, mobile.PeerID(), protocolID(params.ProtocolSync))
+			if err != nil {
+				t.Fatal(err)
+			}
+			defer stream.Close()
+			_ = stream.SetDeadline(time.Now().Add(2 * time.Second))
+			if err := writeMessage(stream, req.typ, req.data); err != nil {
+				t.Fatal(err)
+			}
+			if typ, data, err := readSyncMessage(stream); err == nil {
+				t.Fatalf("mobile served response type %d with %d bytes", typ, len(data))
+			}
+		})
+	}
+	if got := served.Load(); got != 0 {
+		t.Fatalf("served %d data requests", got)
+	}
+
+	t.Run("get_peers", func(t *testing.T) {
+		ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+		defer cancel()
+		stream, err := desktop.host.NewStream(ctx, mobile.PeerID(), protocolID(params.ProtocolPEX))
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer stream.Close()
+		_ = stream.SetDeadline(time.Now().Add(2 * time.Second))
+		if err := writeMessage(stream, PEXMsgGetPeers, nil); err != nil {
+			t.Fatal(err)
+		}
+		if typ, data, err := readPEXMessage(stream); err == nil {
+			t.Fatalf("mobile served PEX type %d with %d bytes", typ, len(data))
+		}
+	})
+
+	t.Run("status_reply", func(t *testing.T) {
+		ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+		defer cancel()
+		stream, err := desktop.host.NewStream(ctx, mobile.PeerID(), protocolID(params.ProtocolSync))
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer stream.Close()
+		_ = stream.SetDeadline(time.Now().Add(2 * time.Second))
+		data, _ := json.Marshal(status)
+		if err := writeMessage(stream, SyncMsgStatus, data); err != nil {
+			t.Fatal(err)
+		}
+		typ, data, err := readSyncMessage(stream)
+		if err != nil || typ != SyncMsgStatus {
+			t.Fatalf("status reply: type=%d err=%v", typ, err)
+		}
+		var got ChainStatus
+		if err := json.Unmarshal(data, &got); err != nil || got.Height != status.Height {
+			t.Fatalf("wrong status reply: %+v, %v", got, err)
+		}
+	})
+
+	t.Run("new_block_ingress", func(t *testing.T) {
+		ctx, cancel := context.WithTimeout(context.Background(), 3*time.Second)
+		defer cancel()
+		stream, err := desktop.host.NewStream(ctx, mobile.PeerID(), protocolID(params.ProtocolSync))
+		if err != nil {
+			t.Fatal(err)
+		}
+		_ = stream.SetDeadline(time.Now().Add(2 * time.Second))
+		if err := writeMessage(stream, SyncMsgNewBlock, []byte("unfunded-test-block")); err != nil {
+			t.Fatal(err)
+		}
+		_ = stream.Close()
+		deadline := time.Now().Add(time.Second)
+		for accepted.Load() == 0 && time.Now().Before(deadline) {
+			time.Sleep(time.Millisecond)
+		}
+		if accepted.Load() != 1 {
+			t.Fatalf("accepted %d block notifications", accepted.Load())
+		}
+	})
+
+	t.Run("mobile_fetches_full_block", func(t *testing.T) {
+		desktopSync := NewSyncManager(desktop, SyncConfig{
+			GetBlocksByHeight: func(uint64, int) ([][]byte, error) { return [][]byte{[]byte("full-block")}, nil },
+			GetStatus:         func() ChainStatus { return status },
+		})
+		desktop.host.SetStreamHandler(protocolID(params.ProtocolSync), desktopSync.HandleStream)
+		blocks, err := mobileSync.fetchBlocksByHeight(peer.ID(desktop.PeerID()), 1, 1)
+		if err != nil || len(blocks) != 1 || string(blocks[0]) != "full-block" {
+			t.Fatalf("mobile fetch: blocks=%q err=%v", blocks, err)
+		}
+	})
+
+	t.Run("block_ingress_does_not_relay", func(t *testing.T) {
+		other := mustNewTestNode(t)
+		defer func() { _ = other.Stop() }()
+		mustConnectNodes(t, mobile, other)
+		var relayed atomic.Int32
+		other.host.SetStreamHandler(protocolID(params.ProtocolBlock), func(s network.Stream) {
+			relayed.Add(1)
+			_ = s.Close()
+		})
+		gotBlock := make(chan struct{}, 1)
+		mobile.SetBlockHandler(func(from peer.ID, data []byte) {
+			mobile.RelayBlock(from, data)
+			gotBlock <- struct{}{}
+		})
+		if err := desktop.sendToPeer(mobile.PeerID(), protocolID(params.ProtocolBlock), []byte("test-announcement")); err != nil {
+			t.Fatal(err)
+		}
+		select {
+		case <-gotBlock:
+		case <-time.After(time.Second):
+			t.Fatal("mobile did not receive block announcement")
+		}
+		time.Sleep(100 * time.Millisecond)
+		if relayed.Load() != 0 {
+			t.Fatal("mobile relayed third-party block")
+		}
+	})
+
+	t.Run("local_dandelion_broadcast", func(t *testing.T) {
+		got := make(chan []byte, 1)
+		desktop.host.SetStreamHandler(protocolID(params.ProtocolDandelion), func(s network.Stream) {
+			defer s.Close()
+			data, err := readLengthPrefixedWithLimit(s, MaxDandelionStreamPayloadSize)
+			if err == nil {
+				got <- data
+			}
+		})
+		mobile.dandel.Start(context.Background())
+		defer mobile.dandel.Stop()
+		mobile.BroadcastTx([]byte("disposable-unfunded-transaction"))
+		select {
+		case data := <-got:
+			if string(data) != "disposable-unfunded-transaction" {
+				t.Fatalf("unexpected local broadcast %q", data)
+			}
+		case <-time.After(3 * time.Second):
+			t.Fatal("local Dandelion stem was not sent")
+		}
+	})
+
+	t.Run("dandelion_ingress_protocols_remain_available", func(t *testing.T) {
+		for _, proto := range []string{params.ProtocolDandelion, params.ProtocolTx} {
+			ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+			stream, err := desktop.host.NewStream(ctx, mobile.PeerID(), protocolID(proto))
+			cancel()
+			if err != nil {
+				t.Fatalf("mobile lost %s ingress: %v", proto, err)
+			}
+			_ = stream.Close()
+		}
+	})
+}
+
+func TestMobileClientOfflinePEXDoesNotBlockLocalStartup(t *testing.T) {
+	cfg := DefaultNodeConfig()
+	cfg.MobileClient = true
+	cfg.AllowOfflineStart = true
+	cfg.SeedNodes = []string{"/ip4/127.0.0.1/tcp/1/p2p/" + testWhitelistPeerID}
+	node, err := NewNode(cfg)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer func() { _ = node.Stop() }()
+	start := time.Now()
+	if err := node.Start(); err != nil {
+		t.Fatal(err)
+	}
+	if took := time.Since(start); took > time.Second {
+		t.Fatalf("offline mobile startup blocked on seed dial for %s", took)
+	}
+}
