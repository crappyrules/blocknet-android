+++ b/api_wallet_activity_readiness_test.go
@@ -0,0 +1,51 @@
+package main
+
+import (
+	"encoding/json"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"testing"
+
+	"blocknet/wallet"
+)
+
+func TestWalletActivityScanningMatchesCanonicalTip(t *testing.T) {
+	w, err := wallet.NewWallet(filepath.Join(t.TempDir(), "disposable.wallet"), []byte("pw"), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	chain := &Chain{}
+	tipHash := [32]byte{0xa1}
+	chain.tipSnap.Store(&tipSnapshot{height: 101, bestHash: tipHash})
+	s := NewAPIServer(&Daemon{chain: chain}, w, nil, t.TempDir(), []byte("pw"))
+	activityScanning := func() bool {
+		t.Helper()
+		rr := httptest.NewRecorder()
+		s.handleWalletActivity(rr, httptest.NewRequest(http.MethodGet, "/api/wallet/activity", nil))
+		if rr.Code != http.StatusOK {
+			t.Fatalf("activity status %d: %s", rr.Code, rr.Body.String())
+		}
+		var response struct {
+			Scanning bool `json:"scanning"`
+		}
+		if err := json.Unmarshal(rr.Body.Bytes(), &response); err != nil {
+			t.Fatal(err)
+		}
+		return response.Scanning
+	}
+	for _, lag := range []uint64{1, 100} {
+		w.SetSyncedTip(101-lag, [32]byte{0xb2})
+		if !activityScanning() {
+			t.Fatalf("activity reported complete with %d blocks of lag", lag)
+		}
+	}
+	w.SetSyncedTip(101, [32]byte{0xb2})
+	if !activityScanning() {
+		t.Fatal("activity reported complete on a same-height fork")
+	}
+	w.SetSyncedTip(101, tipHash)
+	if activityScanning() {
+		t.Fatal("activity reported scanning at the exact canonical tip")
+	}
+}
