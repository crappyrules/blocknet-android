+		// the corrective notification was dropped from the subscriber queue.
+		canonical = chain.GetBlockByHeight(block.Header.Height)
+		if canonical == nil || canonical.Hash() != block.Hash() {
+			reconcileWalletReorg(chain, w, sc)
+		}
 		return
 	}
 	reconcileWalletReorg(chain, w, sc)
