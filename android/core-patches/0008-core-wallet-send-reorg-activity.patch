+package main
+
+import (
+	"context"
+	"path/filepath"
+	"testing"
+
+	"blocknet/wallet"
+)
+
+func makeForkBlocksForWalletTest(t *testing.T, chain *Chain, storage *Storage) (*Block, *Block) {
+	t.Helper()
+	genesis := chain.GetBlockByHeight(0)
+	if genesis == nil {
+		t.Fatal("missing genesis")
+	}
+	a := &Block{Header: BlockHeader{Version: 1, Height: 1, PrevHash: genesis.Hash(),
+		Timestamp: genesis.Header.Timestamp + BlockIntervalSec, Difficulty: MinDifficulty}}
+	b := &Block{Header: BlockHeader{Version: 1, Height: 1, PrevHash: genesis.Hash(),
+		Timestamp: genesis.Header.Timestamp + BlockIntervalSec + 1, Difficulty: MinDifficulty}}
+	if err := storage.CommitBlock(&BlockCommit{Block: a, Height: 1, Hash: a.Hash(), Work: 2, IsMainTip: true}); err != nil {
+		t.Fatal(err)
+	}
+	chain.mu.Lock()
+	chain.height, chain.bestHash = 1, a.Hash()
+	chain.publishTipLocked()
+	chain.mu.Unlock()
+	return a, b
+}
+
+func reorgWalletTestChain(t *testing.T, chain *Chain, storage *Storage, a, b *Block) {
+	t.Helper()
+	if err := storage.CommitReorg(&ReorgCommit{
+		Disconnect: []*Block{a}, Connect: []*Block{b},
+		NewTip: b.Hash(), NewHeight: 1, NewWork: 2,
+	}); err != nil {
+		t.Fatal(err)
+	}
+	chain.mu.Lock()
+	chain.height, chain.bestHash = 1, b.Hash()
+	chain.publishTipLocked()
+	chain.mu.Unlock()
+}
+
+func TestQueuedForwardBlockRepairsCanonicalTipWithoutCorrectionEvent(t *testing.T) {
+	chain, storage, cleanup := mustCreateTestChain(t)
+	defer cleanup()
+	mustAddGenesisBlock(t, chain)
+	a, b := makeForkBlocksForWalletTest(t, chain, storage)
+	w, err := wallet.NewWallet(filepath.Join(t.TempDir(), "disposable.wallet"), []byte("pw"), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	w.SetSyncedTip(0, chain.GetBlockByHeight(0).Hash())
+	reorgWalletTestChain(t, chain, storage, a, b)
+	scanner := wallet.NewScanner(w, defaultScannerConfig())
+	applyBlockToWallet(chain, w, scanner, a) // stale queued notification; B is never delivered
+	if w.SyncedHeight() != 1 || w.SyncedHash() != b.Hash() {
+		t.Fatal("stale forward event did not recover the canonical tip")
+	}
+	applyBlockToWallet(chain, w, scanner, b) // a later canonical notification is harmless
+	if w.SyncedHeight() != 1 || w.SyncedHash() != b.Hash() {
+		t.Fatal("canonical correction event changed a repaired wallet tip")
+	}
+	// A subscriber may instead receive only an older canonical event after
+	// the newest notification was dropped from its bounded queue.
+	lagging, err := wallet.NewWallet(filepath.Join(t.TempDir(), "lagging.wallet"), []byte("pw"), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	genesis := chain.GetBlockByHeight(0)
+	lagging.SetSyncedTip(0, genesis.Hash())
+	applyBlockToWallet(chain, lagging, wallet.NewScanner(lagging, defaultScannerConfig()), genesis)
+	if lagging.SyncedHeight() != 1 || lagging.SyncedHash() != b.Hash() {
+		t.Fatal("older canonical event did not recover a lagging wallet")
+	}
+}
+
+func TestCatchUpReorgBetweenFetchAndScanRepairsCanonicalTip(t *testing.T) {
+	chain, storage, cleanup := mustCreateTestChain(t)
+	defer cleanup()
+	mustAddGenesisBlock(t, chain)
+	a, b := makeForkBlocksForWalletTest(t, chain, storage)
+	d, stop := mustStartTestDaemon(t, chain)
+	defer stop()
+	path := filepath.Join(t.TempDir(), "disposable.wallet")
+	w, err := wallet.NewWallet(path, []byte("pw"), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	w.SetSyncedTip(0, chain.GetBlockByHeight(0).Hash())
+	ctx, cancel := context.WithCancel(context.Background())
+	defer cancel()
+	c := &CLI{ctx: ctx, cancel: cancel, daemon: d, wallet: w}
+	changed := false
+	c.beforeCatchUpBlockApply = func(block *Block) {
+		if block.Hash() != a.Hash() || changed {
+			t.Fatal("catch-up barrier saw unexpected block")
+		}
+		changed = true
+		reorgWalletTestChain(t, chain, storage, a, b)
+	}
+	s := NewAPIServer(d, w, wallet.NewScanner(w, defaultScannerConfig()), t.TempDir(), []byte("pw"))
+	s.cli = c
+	s.catchUpScan()
+	if !changed || w.SyncedHeight() != 1 || w.SyncedHash() != b.Hash() {
+		t.Fatal("catch-up retained the orphaned fetched block")
+	}
+	reloaded, err := wallet.LoadWallet(path, []byte("pw"), defaultWalletConfig())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if reloaded.SyncedHash() != b.Hash() {
+		t.Fatal("canonical reorg repair was not durable")
+	}
+}
