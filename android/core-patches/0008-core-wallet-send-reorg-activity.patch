+package main
+
+import (
+	"bytes"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"path/filepath"
+	"testing"
+	"time"
+
+	"blocknet/wallet"
+)
+
+func TestSendAndAdvancedSendHoldWalletThroughBroadcastAndPersistence(t *testing.T) {
+	for _, advanced := range []bool{false, true} {
+		name := "standard"
+		if advanced {
+			name = "advanced"
+		}
+		t.Run(name, func(t *testing.T) {
+			chain, storage, cleanup := mustCreateTestChain(t)
+			defer cleanup()
+			mustAddGenesisBlock(t, chain)
+			chain.mu.Lock()
+			chain.height = 100 // disposable maturity fixture used by existing send tests
+			chain.publishTipLocked()
+			chain.mu.Unlock()
+			d, stop := mustStartTestDaemon(t, chain)
+			defer stop()
+			path := filepath.Join(t.TempDir(), "disposable.wallet")
+			sender, err := wallet.NewWallet(path, []byte("pw"), defaultWalletConfig())
+			if err != nil {
+				t.Fatal(err)
+			}
+			seedCanonicalSpendableOutput(t, chain, storage, sender, 10_000_000)
+			sender.SetSyncedTip(100, chain.BestHash())
+			if err := sender.Save(); err != nil {
+				t.Fatal(err)
+			}
+			recipient, err := wallet.NewWallet(filepath.Join(t.TempDir(), "recipient.wallet"), []byte("pw"), defaultWalletConfig())
+			if err != nil {
+				t.Fatal(err)
+			}
+			s := NewAPIServer(d, sender, nil, t.TempDir(), []byte("pw"))
+			s.cli = &CLI{daemon: d, wallet: sender}
+			entered, release := make(chan struct{}), make(chan struct{})
+			s.submitTransactionForTest = func(data []byte) error {
+				if len(data) == 0 {
+					return fmt.Errorf("builder supplied empty transaction")
+				}
+				close(entered)
+				<-release
+				return nil // mocked broadcast; no mempool or peer submission
+			}
+			body := fmt.Sprintf(`{"recipients":[{"address":%q,"amount":1,"memo_hex":"00"}]}`, recipient.Address())
+			endpoint := "/api/wallet/send"
+			handler := s.handleSend
+			if advanced {
+				endpoint = "/api/wallet/send/advanced"
+				handler = s.handleSendAdvanced
+				input := sender.AllOutputs()[0]
+				body = fmt.Sprintf(`{"recipients":[{"address":%q,"amount":1,"memo_hex":"00"}],"inputs":[{"txid":"%x","output_index":%d}],"change_split":1}`,
+					recipient.Address(), input.TxID, input.OutputIndex)
+			}
+			sendDone := make(chan *httptest.ResponseRecorder, 1)
+			go func() {
+				rr := httptest.NewRecorder()
+				req := httptest.NewRequest(http.MethodPost, endpoint, bytes.NewBufferString(body))
+				req.RemoteAddr = "198.51.100.45:1234"
+				handler(rr, req)
+				sendDone <- rr
+			}()
+			select {
+			case <-entered:
+			case rr := <-sendDone:
+				t.Fatalf("send stopped before mock broadcast: %d %s", rr.Code, rr.Body.String())
+			case <-time.After(30 * time.Second):
+				t.Fatal("send never reached mock broadcast")
+			}
+			unloadDone := make(chan *httptest.ResponseRecorder, 1)
+			go func() {
+				rr := httptest.NewRecorder()
+				s.handleUnloadWallet(rr, httptest.NewRequest(http.MethodPost, "/api/wallet/unload", nil))
+				unloadDone <- rr
+			}()
+			select {
+			case rr := <-unloadDone:
+				t.Fatalf("unload passed an in-flight send: %d %s", rr.Code, rr.Body.String())
+			case <-time.After(50 * time.Millisecond):
+			}
+			close(release)
+			select {
+			case rr := <-sendDone:
+				if rr.Code != http.StatusOK {
+					t.Fatalf("send status %d: %s", rr.Code, rr.Body.String())
+				}
+			case <-time.After(30 * time.Second):
+				t.Fatal("send did not finish")
+			}
+			select {
+			case rr := <-unloadDone:
+				if rr.Code != http.StatusOK {
+					t.Fatalf("unload status %d: %s", rr.Code, rr.Body.String())
+				}
+			case <-time.After(30 * time.Second):
+				t.Fatal("unload did not finish")
+			}
+			reloaded, err := wallet.LoadWallet(path, []byte("pw"), defaultWalletConfig())
+			if err != nil {
+				t.Fatal(err)
+			}
+			outputs, records := reloaded.AllOutputs(), reloaded.SendRecords()
+			if len(outputs) != 1 || len(records) != 1 || !outputs[0].Spent || outputs[0].SpentTxID != records[0].TxID {
+				t.Fatal("submitted spend and send record were not persisted on the leased wallet")
+			}
+			if reloaded.PendingUnconfirmedBalance() == 0 {
+				t.Fatal("submitted change credit was not persisted")
+			}
+		})
+	}
+}
