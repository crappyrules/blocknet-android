+// beginSendWallet pins one loaded wallet until the handler finishes its local
+// accounting. Callers must release walletOpMu after all post-submit writes.
+func (s *APIServer) beginSendWallet(w http.ResponseWriter) (*wallet.Wallet, bool) {
+	s.walletOpMu.RLock()
+	s.mu.RLock()
+	loaded, locked := s.wallet, s.locked
+	s.mu.RUnlock()
+	if loaded == nil {
+		s.walletOpMu.RUnlock()
+		writeError(w, http.StatusServiceUnavailable, "no wallet loaded")
+		return nil, false
+	}
+	if locked {
+		s.walletOpMu.RUnlock()
+		writeError(w, http.StatusForbidden, "wallet is locked")
+		return nil, false
+	}
+	if loaded.IsViewOnly() {
+		s.walletOpMu.RUnlock()
+		writeError(w, http.StatusForbidden, "view-only wallet cannot send")
+		return nil, false
+	}
+	return loaded, true
+}
+
+func (s *APIServer) submitWalletTransaction(txData []byte) error {
+	if s.submitTransactionForTest != nil {
+		return s.submitTransactionForTest(txData)
+	}
+	return s.daemon.SubmitTransaction(txData)
+}
