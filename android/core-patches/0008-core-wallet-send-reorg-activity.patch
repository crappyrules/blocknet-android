 		}
 		reconcileWalletReorg(chain, w, sc)
 		return
 	}
+	// Notifications can sit in a bounded queue while the chain reorgs. A
+	// block that extends our saved tip may already be off the main chain.
+	canonical := chain.GetBlockByHeight(block.Header.Height)
+	if canonical == nil || canonical.Hash() != block.Hash() {
+		reconcileWalletReorg(chain, w, sc)
+		return
+	}
 	extends := block.Header.Height == syncedHeight+1 && block.Header.PrevHash == syncedHash
 	if extends {
 		sc.ScanBlock(blockToScanData(block))
 		w.SetSyncedTip(block.Header.Height, block.Hash())
